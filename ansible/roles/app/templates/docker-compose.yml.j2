services:
  senabackend:
    container_name: senabackend
    # image: sena-insurance-app:prod
    # build:
    #   context: ./sena-project
    #   dockerfile: Dockerfile
    #   target: prod
    image: {{ harbor_registry }}/{{ image_repo }}:{{ image_tag }}
    env_file:
      - ./{{ app_dir }}/.env
    expose:
      - "9000"
    volumes:
      - ./{{ app_dir }}/storage:/var/www/html/storage/
      - ./php-fpm/uploads.ini:/usr/local/etc/php/conf.d/uploads.ini:ro
    restart: unless-stopped                                   
    networks:
      - sena

  web:
    image: sena-nginx
    container_name: sena-nginx
    build: ./nginx
    ports:
      - "8081:80"

    depends_on:
      - senabackend
      - db

    volumes:
      - ./{{ app_dir}}:/var/www/html
      - ./{{ nginx_dir }}/default.conf:/etc/nginx/conf.d/default.conf:ro    
      - ./{{ nginx_dir }}/logs:/var/log/nginx

    restart: unless-stopped                                       
    networks:
      - sena


  db:
    image: postgres:16
    container_name: postgres-container
    restart: unless-stopped

    ports:
      - "5432:5432"

    environment:
      POSTGRES_DB: {{ DB_NAME }} 
      POSTGRES_USER: {{ DB_USER }}
      POSTGRES_PASSWORD: {{ DB_PASSWORD }}

    volumes:
      - ./db/postgres/data:/var/lib/postgresql/data
      - ./db/postgres/sql:/docker-entrypoint-initdb.d

    networks:
      - sena

  adminer:
    image: adminer:latest
    container_name: sena-adminer
    restart: unless-stopped
    ports:
      - "8080:8080"
    depends_on:
      - db
    networks:
      - sena

  third-party-simulator:
    container_name: sim-service
    build:
      context: ./third-party-service-simul
      dockerfile: Dockerfile
    ports:
      - "9001:3000"
    environment:
      - PORT=3000
    restart: always
    networks:
      - sena

networks:
  sena:
    external: true