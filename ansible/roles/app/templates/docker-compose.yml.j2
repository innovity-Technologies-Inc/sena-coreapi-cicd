version: '3.8'

services:
  senabackend:
    container_name: senabackend
    image: {{ harbor_registry }}/{{ image_repo }}:{{ image_tag default('latest') }}
    env_file:
      - {{ app_dir }}/.env
    expose:
      - "{{ appication_port }}"
    volumes:
      - {{ app_dir }}/storage:/var/www/html/storage/
      - {{ fpm_dir }}/uploads.ini:/usr/local/etc/php/conf.d/uploads.ini:ro                                 
    networks:
      - {{ shared_network }}
    deploy:
      replicas: 1
      restart_policy:
        condition: on-failure

  web:
    image: sena-nginx:latest
    # container_name: sena-nginx
    # build: 
    #   context: ./nginx
    #   dockerfile: Dockerfile
    ports:
      - "{{ nginx_host_port }}:{{ nginx_container_port }}"

    depends_on:
      - senabackend

    volumes:
      - {{ app_dir}}:/var/www/html
      - {{ nginx_dir }}/default.conf:/etc/nginx/conf.d/default.conf:ro    
      - {{ nginx_dir }}:/var/log/nginx
                                    
    networks:
      - {{ shared_network }}
    deploy:
      replicas: 1
      restart_policy:
        condition: on-failure


