# Swarm application stack managed by Ansible. Contains credentials; keep mode 0600.
version: "3.8"
services:
  senabackend:
    image: {{ (app_image_registry ~ ':' ~ image_tag) | to_json }}
    environment:
{% for key, value in app_environment_variables.items() %}
      {{ key }}: {{ value | string | replace('$', '$$') | to_json }}
{% endfor %}
    secrets:
      - source: firebase_key
        target: /var/www/html/firebase-credentials.json
        uid: "33"
        gid: "33"
        mode: 0400
    ports:
      - target: {{ app_fpm_port | int }}
        published: {{ app_published_port | int }}
        protocol: tcp
        mode: ingress
    volumes:
{% if app_storage_backend == 'nfs' %}
      - type: volume
        source: app_storage
        target: /var/www/html/storage
        volume:
          nocopy: true
{% else %}
      - type: bind
        source: {{ app_storage_path | to_json }}
        target: /var/www/html/storage
{% endif %}
    networks:
      - app_network
    stop_grace_period: 90s
    healthcheck:
      test: ["CMD", "php", "-r", "exit(@fsockopen('127.0.0.1', {{ app_fpm_port }}) ? 0 : 1);"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: {{ app_healthcheck_start_period | to_json }}
    deploy:
      replicas: {{ app_service_replicas | int }}
{% if app_storage_backend == 'bind' %}
      placement:
        constraints:
          - {{ ('node.id == ' ~ app_storage_node_id) | to_json }}
{% endif %}
      restart_policy:
        condition: on-failure
        delay: 5s
      update_config:
        parallelism: 1
        order: stop-first
        failure_action: pause
        monitor: 60s
      rollback_config:
        parallelism: 1
        order: stop-first
networks:
  app_network:
    external: true
    name: {{ app_shared_network | to_json }}
secrets:
  firebase_key:
    external: true
    name: {{ app_firebase_secret_name | to_json }}
{% if app_storage_backend == 'nfs' %}
volumes:
  app_storage:
    name: {{ app_storage_volume_name | to_json }}
    driver: local
    driver_opts:
      type: nfs
      o: {{ ('addr=' ~ app_nfs_server ~ ',nfsvers=4,rw,hard') | to_json }}
      device: {{ (':' ~ app_nfs_export_path) | to_json }}
{% endif %}
