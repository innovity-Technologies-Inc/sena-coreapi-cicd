# Managed by Ansible. Contains credentials; keep mode 0600.
version: "3.8"
services:
  migrate:
    image: {{ (app_image_registry ~ ':' ~ image_tag) | to_json }}
    user: "33:33"
    command: ["php", "artisan", "migrate", "--force", "--no-interaction"]
    environment:
{% for key, value in app_environment_variables.items() %}
      {{ key }}: {{ value | string | replace('$', '$$') | to_json }}
{% endfor %}
    secrets:
      - source: firebase_key
        target: /var/www/html/firebase-credentials.json
        uid: "33"
        gid: "33"
        mode: 0400
    volumes:
{% if app_storage_backend == 'nfs' %}
      - type: volume
        source: app_storage
        target: /var/www/html/storage
        volume:
          nocopy: true
{% else %}
      - type: bind
        source: {{ app_storage_path | to_json }}
        target: /var/www/html/storage
{% endif %}
    networks:
      - app_network
    deploy:
      replicas: 1
{% if app_storage_backend == 'bind' %}
      placement:
        constraints:
          - {{ ('node.id == ' ~ app_storage_node_id) | to_json }}
{% endif %}
      restart_policy:
        condition: none
networks:
  app_network:
    external: true
    name: {{ app_shared_network | to_json }}
secrets:
  firebase_key:
    external: true
    name: {{ app_firebase_secret_name | to_json }}
{% if app_storage_backend == 'nfs' %}
volumes:
  app_storage:
    name: {{ app_storage_volume_name | to_json }}
    driver: local
    driver_opts:
      type: nfs
      o: {{ ('addr=' ~ app_nfs_server ~ ',nfsvers=4,rw,hard') | to_json }}
      device: {{ (':' ~ app_nfs_export_path) | to_json }}
{% endif %}
